@page
@model Webshop.Pages.OrderHistoryModel
@{
    ViewData["Title"] = "Min ordrehistorik";
}

<div class="container py-5">
    <h1>Min ordrehistorik</h1>

    @if (Model.Orders.Count == 0)
    {
        <div class="alert alert-info">
            Du har ikke nogle ordrer endnu. <a asp-page="/Products">Handl nu</a>.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Ordre-ID</th>
                        <th>Dato</th>
                        <th>Status</th>
                        <th class="text-end">Totalbeløb</th>
                        <th class="text-center">Linjer</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        var statusClass = order.Status switch
                        {
                            Webshop.Model.OrderStatus.Paid => "bg-success",
                            Webshop.Model.OrderStatus.Pending => "bg-warning",
                            Webshop.Model.OrderStatus.Shipped => "bg-primary",
                            Webshop.Model.OrderStatus.Cancelled => "bg-danger",
                            _ => "bg-secondary"
                        };
                        <tr>
                            <td>#@order.Id</td>
                            <td>@order.OrderDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                <span class="badge @statusClass">@order.Status</span>
                            </td>
                            <td class="text-end">
                                <strong>@order.Total.ToString("N2") kr.</strong>
                            </td>
                            <td class="text-center">@order.Lines.Count stk.</td>
                            <td class="text-end">
                                <a asp-page="/OrderDetail" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                                    Detaljer
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>