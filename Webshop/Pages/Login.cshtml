@page
@model Webshop.Pages.LoginModel
@{
    ViewData["Title"] = "Log ind";
}

<h1>Log ind</h1>
@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success">@status</div>
}
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.UserName" class="form-label">Brugernavn</label>
        <input asp-for="Input.UserName" class="form-control" autocomplete="username" />
        <span asp-validation-for="Input.UserName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label">Adgangskode</label>
        <input asp-for="Input.Password" class="form-control" type="password" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Log ind</button>
</form>
<p class="text-center mt-3 mb-0">
    Ny her? <a asp-page="/Register">Opret en konto</a>
</p>