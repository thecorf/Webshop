@page
@model Webshop.Pages.ChangePasswordModel
@{
    ViewData["Title"] = "Skift adgangskode";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="mb-4">Skift adgangskode</h2>

                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="Input.CurrentPassword" class="form-label">Nuværende adgangskode</label>
                            <input asp-for="Input.CurrentPassword" class="form-control"
                                   type="password" autocomplete="current-password" />
                        </div>

                        <hr class="my-4" />

                        <div class="mb-3">
                            <label asp-for="Input.NewPassword" class="form-label">Ny adgangskode</label>
                            <input asp-for="Input.NewPassword" class="form-control"
                                   type="password" autocomplete="new-password" />
                            <div class="form-text">
                                Minimum 8 tegn, ét tal og ét specialtegn.
                                Må ikke indeholde dit brugernavn eller e-mail.
                            </div>
                        </div>
                        <div class="progress mt-1" style="height: 8px;" aria-hidden="true">
                            <div id="pwMeterBar" class="progress-bar" style="width: 0%"></div>
                        </div>
                        <small id="pwMeterText" class="form-text">&nbsp;</small>

                        <script>
                            (function () {
                                // Register:      'Input_Password'
                                // ChangePassword: 'Input_NewPassword'
                                var input = document.getElementById('Input_NewPassword');
                                var bar = document.getElementById('pwMeterBar');
                                var text = document.getElementById('pwMeterText');
                                if (!input || !bar) return;

                                var labels = ['For kort', 'Svag', 'Okay', 'Stærk', 'Meget stærk'];
                                var colors = ['#e9ecef', '#dc3545', '#fd7e14', '#ffc107', '#198754'];

                                function score(pw) {
                                    if (!pw) return 0;
                                    var s = 0;
                                    if (pw.length >= 8) s++;
                                    if (pw.length >= 12) s++;
                                    if (pw.length >= 16) s++;
                                    var classes = /[a-z]/.test(pw) + /[A-Z]/.test(pw) + /\d/.test(pw) + /[^a-zA-Z0-9\s]/.test(pw);
                                    if (classes >= 3) s++;
                                    if (/(.)\1{3,}/.test(pw) || /(0123|1234|2345|abcd|bcde|qwer|asdf)/i.test(pw)) s -= 2;
                                    return Math.max(0, Math.min(4, s));
                                }

                                input.addEventListener('input', function () {
                                    var s = score(input.value);
                                    bar.style.width = (s * 25) + '%';
                                    bar.style.backgroundColor = colors[s];
                                    text.textContent = input.value ? labels[s] : '\u00a0';
                                });
                            })();
                        </script>

                        <div class="mb-4">
                            <label asp-for="Input.ConfirmPassword" class="form-label">Gentag ny adgangskode</label>
                            <input asp-for="Input.ConfirmPassword" class="form-control"
                                   type="password" autocomplete="new-password" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Skift adgangskode</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>