<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Webshop</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Webshop.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <!-- Topbar (FORSIKKER: kun navbars der vises på alle sider) -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
            <div class="container">
                <!-- Logo / Home -->
                <a class="navbar-brand fw-bold" asp-page="/Index">
                    Coffee Shop
                </a>

                <!-- Hamburger-menu til mobil -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Centralt navigationsindhold -->
                <div class="collapse navbar-collapse" id="navbarContent">
                    <!-- Venstre side: Produkter-link -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Products">Produkter</a>
                        </li>
                    </ul>

                    <!-- Højre side: Kurv + Profil -->
                    <div class="d-flex align-items-center gap-3">
                        @await Component.InvokeAsync("CartBadge")
                        <div class="vr" style="height: 32px;"></div>
                        @await Component.InvokeAsync("UserProfile")
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Webshop - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
