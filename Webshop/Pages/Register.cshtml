@page
@model Webshop.Pages.RegisterModel
@{
    ViewData["Title"] = "Opret konto";
}

<h1>Opret konto</h1>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.UserName" class="form-label">Brugernavn</label>
        <input asp-for="Input.UserName" class="form-control" autocomplete="username" />
        <span asp-validation-for="Input.UserName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.FullName" class="form-label">Fulde navn</label>
        <input asp-for="Input.FullName" class="form-control" autocomplete="name" />
        <span asp-validation-for="Input.FullName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">E-mail</label>
        <input asp-for="Input.Email" class="form-control" type="email" autocomplete="email" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label">Adgangskode</label>
        <input asp-for="Input.Password" class="form-control" type="password"
               autocomplete="new-password" minlength="8" />
        <div class="form-text">
            Minimum 8 tegn, ét tal og ét specialtegn.
            <br />Adgangskoden må ikke indeholde dit brugernavn eller email.
        </div>
        <!-- Strength meter kan tilføjes her -->
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.ConfirmPassword" class="form-label">Gentag adgangskode</label>
        <input asp-for="Input.ConfirmPassword" class="form-control" type="password"
               autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>
    <div class="progress mt-1" style="height: 8px;" aria-hidden="true">
        <div id="pwMeterBar" class="progress-bar" style="width: 0%"></div>
    </div>
    <small id="pwMeterText" class="form-text">&nbsp;</small>

    <script>
        (function () {
            // Register:      'Input_Password'
            // ChangePassword: 'Input_NewPassword'
            var input = document.getElementById('Input_Password');
            var bar = document.getElementById('pwMeterBar');
            var text = document.getElementById('pwMeterText');
            if (!input || !bar) return;

            var labels = ['For kort', 'Svag', 'Okay', 'Stærk', 'Meget stærk'];
            var colors = ['#e9ecef', '#dc3545', '#fd7e14', '#ffc107', '#198754'];

            function score(pw) {
                if (!pw) return 0;
                var s = 0;
                if (pw.length >= 8) s++;
                if (pw.length >= 12) s++;
                if (pw.length >= 16) s++;
                var classes = /[a-z]/.test(pw) + /[A-Z]/.test(pw) + /\d/.test(pw) + /[^a-zA-Z0-9\s]/.test(pw);
                if (classes >= 3) s++;
                if (/(.)\1{3,}/.test(pw) || /(0123|1234|2345|abcd|bcde|qwer|asdf)/i.test(pw)) s -= 2;
                return Math.max(0, Math.min(4, s));
            }

            input.addEventListener('input', function () {
                var s = score(input.value);
                bar.style.width = (s * 25) + '%';
                bar.style.backgroundColor = colors[s];
                text.textContent = input.value ? labels[s] : '\u00a0';
            });
        })();
    </script>
    <button type="submit" class="btn btn-primary">Opret konto</button>
</form>


<p class="text-center mt-3 mb-0">
    Har du allerede en konto? <a asp-page="/Login">Log ind her!</a>
</p>