@page
@model Webshop.Pages.LogoutModel
@{
    ViewData["Title"] = "Log ud";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24"
                         fill="none" stroke="#28a745" stroke-width="1.6" stroke-linecap="round"
                         stroke-linejoin="round" class="mb-3">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                        <polyline points="16 17 21 12 16 7" />
                        <line x1="21" y1="12" x2="9" y2="12" />
                    </svg>

                    <h2 class="mb-3">Log ud?</h2>
                    <p class="text-muted mb-4">Du bliver logget ud af din konto.</p>

                    <form method="post">
                        <button type="submit" class="btn btn-success btn-lg w-100 mb-2">
                            Log ud
                        </button>
                        <a asp-page="/Index" class="btn btn-outline-secondary btn-lg w-100">
                            Annullér
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>